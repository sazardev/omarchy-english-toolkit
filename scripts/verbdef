#!/usr/bin/env bash
# verbdef - look up English verbs from the terminal, offline.
#
#   verbdef                the irregular list
#   verbdef go             everything about one verb
#   verbdef -l             all 415 bases
#   verbdef -r             the six regular rules
#   verbdef -s             all situations
#   verbdef -t             the common traps
#   verbdef -h             this help
#
# The data is the same JSON the website uses, so the two never disagree.
# If a browser is more convenient, the site is at the repo's Pages URL.
set -uo pipefail

# The script is installed to ~/.local/bin, so the data is not next to it.
# Look in the places it can plausibly be, and let VERBDEF_JSON override.
find_json() {
  local here
  here="$(dirname "$(readlink -f "$0")")"
  for c in \
    "${VERBDEF_JSON:-}" \
    "$here/../web/data/verbs.json" \
    "$here/../../web/data/verbs.json" \
    "$HOME/Work/omarchy-english-toolkit/web/data/verbs.json" \
    "$HOME/.local/share/verbdef/verbs.json"
  do
    [[ -n "$c" && -f "$c" ]] && { printf '%s' "$c"; return 0; }
  done
  return 1
}
JSON="$(find_json)" || {
  echo "verbdef: cannot find verbs.json." >&2
  echo "  set VERBDEF_JSON=/path/to/verbs.json" >&2
  exit 1
}
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/verbdef.json"

B=$'\033[1m'; D=$'\033[2m'; C=$'\033[1;36m'; A=$'\033[1;33m'; O=$'\033[0m'

[[ -f $JSON ]] || { echo "verbdef: data not found: $JSON" >&2; exit 1; }
command -v jq >/dev/null || { echo "verbdef: jq is required" >&2; exit 1; }

py() { python3 -c "$1" "$JSON" "${2:-}"; }

case "${1:-}" in
  -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

if [[ "${1:-}" == "-l" ]]; then
  jq -r '.verbs[].base' "$JSON" | column -c 100 2>/dev/null || jq -r '.verbs[].base' "$JSON"
  exit 0
fi

if [[ "${1:-}" == "-r" ]]; then
  echo
  echo "${B}${C}The six rules for regular verbs${O}"
  echo "${D}Test in this order: R6, R3, R5, R2, R1.${O}"
  echo "${D}The earlier rules are the exceptions to the later ones.${O}"
  echo
  jq -r '.rules[] |
    "\(.id)  \(.name)\n     when: \(.test)\n     e.g.  \(.how)\n     \(.note)\n"' "$JSON"
  echo "${D}Then: which rule fires for a given verb?${O}"
  jq -r '.decisions[] | "  \(.base)\((" " * (14 - (.base|length))))\(.rule)   \(.why)"' "$JSON" | head -25
  exit 0
fi

if [[ "${1:-}" == "-s" ]]; then
  echo
  echo "${B}${C}Which verb fits which situation${O}"
  echo
  jq -r '.scenarios[] |
    "\(.title)\n     \(.form)\n     \(.frame)\n     \(.why)\n     verbs: \(.verbs | join(", "))\n"' "$JSON"
  exit 0
fi

if [[ "${1:-}" == "-t" ]]; then
  echo
  echo "${B}${A}Common mistakes${O}"
  echo
  jq -r '.traps[] | "  \u001b[31m\(.wrong)\u001b[0m\n  \u001b[32m\(.right)\u001b[0m\n     \(.rule)\n"' "$JSON"
  exit 0
fi

if [[ -n "${1:-}" ]]; then
  w="$1"
  found=$(jq --arg w "$w" '[.verbs[] | select(.base==$w or .past==$w or .participle==$w or .third==$w or .ing==$w)]' "$JSON")
  n=$(jq 'length' <<<"$found")
  if [[ "$n" == "0" ]]; then
    echo "verbdef: '$w' is not an irregular verb." >&2
    echo "  If it is regular, one of the six rules covers it:  verbdef -r" >&2
    exit 1
  fi
  jq -r '.[] |
    "\n\(.base)\n" +
    (if .meaning then "  \(.meaning)\n" else "" end) +
    (if .note then "  \u001b[2m\(.note)\u001b[0m\n" else "" end) +
    "  \u001b[2m3rd person\u001b[0m    \(.third)\n" +
    "  \u001b[2mpast\u001b[0m         \(.past)\n" +
    "  \u001b[2mpast participle\u001b[0m \(.participle)\n" +
    "  \u001b[2m-ing\u001b[0m          \(.ing)\n"' <<<"$found"
  exit 0
fi

# no argument: a compact summary
echo
echo "${B}${C}verbdef${O}  ${D}$(jq -r '.count' "$JSON") irregular verbs, offline${O}"
echo
echo "  ${B}verbdef go${O}        one verb, all four forms"
echo "  ${B}verbdef -l${O}         list every base form"
echo "  ${B}verbdef -r${O}         the six regular-verb rules"
echo "  ${B}verbdef -s${O}         which verb fits which situation"
echo "  ${B}verbdef -t${O}         the common mistakes"
echo
echo "  ${D}try:  verbdef write, verbef -r, verbdef -s, verbdef -t${O}"
echo
